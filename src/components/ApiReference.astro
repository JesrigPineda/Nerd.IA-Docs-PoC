---
import { ScalarComponent } from '@scalar/astro';

interface Props {
	locale: 'es' | 'en';
}

const { locale } = Astro.props;

const hiddenClients = {
	c: true,
	clojure: true,
	csharp: true,
	dart: true,
	fsharp: true,
	go: true,
	http: true,
	java: true,
	kotlin: true,
	node: true,
	objc: true,
	ocaml: true,
	php: true,
	powershell: true,
	python: true,
	r: true,
	ruby: true,
	rust: true,
	swift: true,
	js: ['axios', 'jquery', 'ofetch', 'xhr'],
	shell: ['httpie', 'wget'],
} as const;
---

<div class="api-reference-shell">
	<ScalarComponent
		renderMode="client"
		configuration={{
			url: '/openapi.yaml',
			theme: 'default',
			localization: { locale },
			agent: { disabled: true },
			hideTestRequestButton: true,
			defaultHttpClient: { targetKey: 'shell', clientKey: 'curl' },
			hiddenClients,
			withDefaultFonts: false,
			customCss: `
				.scalar-app {
					--scalar-font: var(--__sl-font);
					--scalar-font-code: var(--__sl-font-mono);
				}
			`,
		}}
	/>
</div>
